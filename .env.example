# ====================================================================
# PayPilot AI - Environment Configuration
# ====================================================================
# Rename or copy this file to '.env' in this root folder.
# NOTE: PayPilot AI is designed to work in ZERO-CONFIG DEMO MODE out-of-the-box!
# You do NOT need live API keys to run and test the complete system.
# When credentials are provided below, it automatically activates live mode.

# --- PayPal Sandbox Credentials ---
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# --- Google Gemini AI API Key ---
# Optional: Obtain from https://aistudio.google.com/
# If left blank, PayPilot operates using its built-in Autonomous Heuristic AI Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Application Server ---
PORT=8000
HOST=127.0.0.1
